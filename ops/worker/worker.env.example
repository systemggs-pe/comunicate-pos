# Guardar root:communicate 0640. No DNI token ni claves B2 aquí.
NODE_ENV=production
DATABASE_URL=
WORKER_DATABASE_URL=
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_ENCRYPTION_PROVIDER=r2-managed
WORKER_BATCH_SIZE=25
WORKER_MAX_BATCHES=2
WORKER_TIMEOUT_MS=90000
WORKER_STATUS_FILE=/var/lib/communicate/worker-status.json
MAINTENANCE_MODE=false
