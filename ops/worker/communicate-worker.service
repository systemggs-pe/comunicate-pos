[Unit]
Description=COMUNICATE POS bounded maintenance
After=network-online.target

[Service]
Type=oneshot
User=communicate
Group=communicate
WorkingDirectory=/opt/communicate/current
EnvironmentFile=/etc/communicate/worker.env
ExecStart=/usr/bin/node build-server/scripts/worker.mjs
SuccessExitStatus=2
TimeoutStartSec=130
TimeoutStopSec=25
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/communicate
UMask=0077
MemoryMax=512M
CPUQuota=50%
