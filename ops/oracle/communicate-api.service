[Unit]
Description=COMUNICATE POS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=communicate
Group=communicate
WorkingDirectory=/opt/communicate/current
EnvironmentFile=/etc/communicate/api.env
ExecStart=/usr/bin/node build-server/server/production.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
UMask=0077
MemoryMax=1G
CPUQuota=100%
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
