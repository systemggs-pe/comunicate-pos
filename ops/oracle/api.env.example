# Plantilla privada del servidor; completar manualmente fuera del repositorio.
NODE_ENV=production
PORT=3001
TRUST_LOOPBACK_PROXY=true
AUTH_ALLOWED_ORIGINS=
WEB_SITE_DOMAIN=
DATABASE_URL=
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_ENCRYPTION_PROVIDER=r2-managed
S3_UPLOAD_URL_TTL_SECONDS=60
S3_DOWNLOAD_URL_TTL_SECONDS=30
MAX_EVIDENCE_FILE_SIZE=10485760
DNI_PROVIDER=api
DNI_API_URL=
DNI_API_TOKEN=
MAINTENANCE_MODE=false
HTTP_LOGGING=true
