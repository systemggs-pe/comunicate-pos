# Plantilla privada del servidor; completar manualmente fuera del repositorio.
NODE_ENV=production
PORT=3001
TRUST_LOOPBACK_PROXY=true
AUTH_ALLOWED_ORIGINS=
WEB_SITE_DOMAIN=
# Usar el origen HTTPS de la API cuando Cloudflare Pages y la API usan subdominios distintos.
GOOGLE_OIDC_API_ORIGIN=
GOOGLE_OIDC_APP_ORIGIN=
GOOGLE_OIDC_REDIRECT_URI=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_AUTHORIZED_ACCOUNTS='{}'
DATABASE_URL=
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_ENCRYPTION_PROVIDER=r2-managed
S3_UPLOAD_URL_TTL_SECONDS=60
S3_DOWNLOAD_URL_TTL_SECONDS=30
MAX_EVIDENCE_FILE_SIZE=10485760
DNI_PROVIDER=api
DNI_API_URL=
DNI_API_TOKEN=
CODART_ENABLED=false
CODART_API_KEY=
CODART_PHOTO_STORAGE_AUTHORIZED=false
MAINTENANCE_MODE=false
HTTP_LOGGING=true
