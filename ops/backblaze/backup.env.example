# Sólo proceso autorizado de backup; clave AES fuera de B2 y del backup.
NODE_ENV=production
BACKUP_DATABASE_URL=
BACKUP_BUCKET=
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_ENCRYPTION_PROVIDER=r2-managed
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
BACKUP_DIRECTORY=
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=3
BACKUP_MAX_RETAINED_BYTES=8000000000
BACKUP_ESTIMATED_COPY_BYTES=0
BACKUP_ESTIMATED_COPIES=4
BACKUP_STATUS_FILE=/var/lib/communicate/backup-status.json
BACKUP_ID=
RESTORE_CONFIRM_DATABASE=
# Vacíos: retención sólo lista candidatos, no elimina automáticamente.
BACKUP_DELETE_ID=
BACKUP_DELETE_CONFIRM=
