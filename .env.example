# Exclusivamente desarrollo local. Nunca reutilizar estas credenciales en producción.
DATABASE_URL="postgresql://communicate:communicate_local@127.0.0.1:55432/communicate_pos?schema=public&connection_limit=5"
TEST_DATABASE_URL="postgresql://communicate:communicate_local@127.0.0.1:55432/communicate_pos_test?schema=public&connection_limit=5"
# Lista exacta de orígenes del frontend. En producción es obligatoria; nunca usar *.
AUTH_ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175"
# Sólo durante bootstrap inicial; define valores privados, sin prefijo VITE_.
ADMIN_NAME=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
PORT=3001
# Sólo servidor: nunca usar prefijo VITE_. Mock contiene únicamente identidades ficticias.
# En producción configura api; mock no se habilita en producción.
DNI_PROVIDER=mock
DNI_API_URL=""
DNI_API_TOKEN=""
DNI_TIMEOUT_MS=4000
DNI_CACHE_TTL_MS=60000
# Storage privado local. Nunca reutilizar estas credenciales en producción.
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=communicate-evidence
S3_ACCESS_KEY_ID=evidence_dev_admin
S3_SECRET_ACCESS_KEY=evidence_local_only_2026
S3_FORCE_PATH_STYLE=true
MAX_EVIDENCE_FILE_SIZE=10485760
S3_UPLOAD_URL_TTL_SECONDS=60
S3_DOWNLOAD_URL_TTL_SECONDS=30
# SSE opcional; su compatibilidad depende del proveedor. Producción no verificada.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=
# R2: r2-managed sólo declara la opción de proveedor; exige evidencia externa.
S3_ENCRYPTION_PROVIDER=
# Operación: pausa las escrituras durante un respaldo coherente.
MAINTENANCE_MODE=false
HTTP_LOGGING=false
# Producción: URL directa exclusiva del operador para migraciones/backups.
# Exigir sslmode=require&sslaccept=strict; DATABASE_URL con pool limitado.
DIRECT_URL=
# Backups locales: configuración explícita, no valores por defecto ni secretos versionados.
BACKUP_DATABASE_URL=
BACKUP_BUCKET=
BACKUP_DIRECTORY=
BACKUP_PASSPHRASE=
RESTORE_CONFIRM_DATABASE=
# Phase 10A: URL pública absoluta HTTPS /api; vacío mantiene proxy local.
VITE_API_BASE_URL=
WEB_SITE_DOMAIN=
TRUST_LOOPBACK_PROXY=false
WORKER_DATABASE_URL=
WORKER_BATCH_SIZE=25
WORKER_MAX_BATCHES=2
WORKER_TIMEOUT_MS=90000
WORKER_STATUS_FILE=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=3
BACKUP_MAX_RETAINED_BYTES=8000000000
BACKUP_ESTIMATED_COPY_BYTES=0
BACKUP_ESTIMATED_COPIES=4
BACKUP_STATUS_FILE=
BACKUP_ID=
BACKUP_DELETE_ID=
BACKUP_DELETE_CONFIRM=

# MVP01: externos desactivados hasta configurar y autorizar uso/costos.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_LIMIT=20
CODART_ENABLED=false
CODART_API_TOKEN=
CODART_PHOTO_STORAGE_AUTHORIZED=false
CLIENT_DOCUMENT_RETENTION_DAYS=365
